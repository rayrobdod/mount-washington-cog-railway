		default: sprites_train_horizontalboiler;
	}
}
item(FEAT_TRAINS, item_train_spirit) {
	property {
		name: string(STR_SPIRIT_NAME);
		climates_available: ALL_CLIMATES;
		introduction_date: date(1976,01,01);
		model_life: 10;
		vehicle_life: 10;
		reliability_decay: 20;
		refittable_cargo_classes: 0;
		loading_speed: 5;
		cost_factor: 25;
		running_cost_factor: 100 / 3;

		sprite_id: SPRITE_ID_NEW_TRAIN;
		speed: SPEED_MULTIPLIER * 4mph;
		track_type: COG;
		power: DARTBOARD_DETERMINED_POWER_SPIRIT hp;
		running_cost_base: RUNNING_COST_DIESEL;
		cargo_capacity: 0;
		weight: DARTBOARD_DETERMINED_WEIGHT_LIGHTER ton;
		engine_class: ENGINE_CLASS_DIESEL;
		tractive_effort_coefficient: 1;
		length: 8;
		badges: [
			"flag/US",
			"power/diesel",
			"role/prototype",
		];
	}
	graphics {
		default: sprites_train_spirit;
	}
}
item(FEAT_TRAINS, item_train_diesel) {
	property {
		name: string(STR_DIESEL_NAME);
		climates_available: ALL_CLIMATES;
		introduction_date: date(2008,01,01);
		model_life: VEHICLE_NEVER_EXPIRES;
		vehicle_life: 30;
		reliability_decay: 20;
		refittable_cargo_classes: 0;
		loading_speed: 5;
		cost_factor: 20;
		running_cost_factor: 100 / 3; // Whatever the real cost of the steam trains, the biodiesel is a third of that

		sprite_id: SPRITE_ID_NEW_TRAIN;
		// Real speed is 5mph, but other in-game trains can exceed that without difficulty even on slopes
		speed: SPEED_MULTIPLIER * 5mph;
		track_type: COG;
		power: 600 hp; // https://www.thecog.com/diesel-debut
		running_cost_base: RUNNING_COST_DIESEL;
		cargo_capacity: 0;
		weight: DARTBOARD_DETERMINED_WEIGHT ton;
		engine_class: ENGINE_CLASS_DIESEL;
		tractive_effort_coefficient: 1;
		length: 8;
		badges: [
			"flag/US",
			"power/diesel",
		];
	}
	graphics {
		default: sprites_train_wajonanatasis;
	}
}


item(FEAT_TRAINS, item_train_shingle) {
	property {
		name: string(STR_SHINGLE_NAME);
		climates_available: ALL_CLIMATES;
		introduction_date: date(1866,08,01);
		model_life: 40;
		vehicle_life: 5;
		reliability_decay: 20;
		refittable_cargo_classes: bitmask(CC_PASSENGERS);
		loading_speed: 5;
		cost_factor: 1;
		running_cost_factor: 5;

		sprite_id: SPRITE_ID_NEW_TRAIN;
		speed: 60mph;
		misc_flags: bitmask(TRAIN_FLAG_NO_BREAKDOWN_SMOKE);
		extra_flags: bitmask(VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW);
		track_type: COG;
		ai_special_flag: AI_FLAG_PASSENGER;
		power: 1 hp;
		running_cost_base: RUNNING_COST_NONE;
		default_cargo_type: PASS;
		cargo_capacity: 4;
		weight: 1 ton;
		engine_class: ENGINE_CLASS_STEAM; // Really more gravity powered than anything else
		tractive_effort_coefficient: 0.1;
		air_drag_coefficient: 0.02;
		length: 3;
		visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
		badges: [
			"flag/US",
		];
	}
	graphics {
		default: spritegroup_train_shingle;
		can_attach_wagon: string(STR_ERROR_CANNOT_ATTACH_ANY);
	}
}
item(FEAT_TRAINS, item_train_speeder) {
	property {
		name: string(STR_SPEEDER_NAME);
		climates_available: ALL_CLIMATES;
		introduction_date: date(1975,01,01);
		model_life: VEHICLE_NEVER_EXPIRES;
		vehicle_life: 20;
		reliability_decay: 20;
		refittable_cargo_classes: bitmask(CC_PASSENGERS);
		loading_speed: 5;
		cost_factor: 10;
		running_cost_factor: 10;

		sprite_id: SPRITE_ID_NEW_TRAIN;
		// up mtn in 15 minutes, compared to diesel's 40 minute travel time
		speed: SPEED_MULTIPLIER * 13mph;
		extra_flags: bitmask(VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW);
		track_type: COG;
		ai_special_flag: AI_FLAG_PASSENGER;
		power: DARTBOARD_DETERMINED_POWER_SPEEDER hp;
		running_cost_base: RUNNING_COST_DIESEL;
		default_cargo_type: PASS;
		cargo_capacity: 4;
		weight: DARTBOARD_DETERMINED_WEIGHT_SPEEDER ton;
		engine_class: ENGINE_CLASS_DIESEL;
		tractive_effort_coefficient: 0.9;
		length: 6;
		badges: [
			"flag/US",
			"power/diesel",
		];
	}
	graphics {
		default: sprites_train_speeder;
		can_attach_wagon: string(STR_ERROR_CANNOT_ATTACH_ANY);
	}
}


item(FEAT_TRAINS, item_wagon_passenger) {
	property {
		name: string(STR_PASSENGER_NAME);
		climates_available: ALL_CLIMATES;
		// Although not fully complete, passenger excursions started 1868, with the rest of the track being completed the following year
		introduction_date: date(1868,08,14);
		model_life: VEHICLE_NEVER_EXPIRES;
		loading_speed: 5;
		cost_factor: 100;
		running_cost_factor: 100;

		sprite_id: SPRITE_ID_NEW_TRAIN;
		extra_flags: bitmask(VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_TRAIN_HAS_CAB);
		track_type: COG;
		power: 0;
		running_cost_base: RUNNING_COST_NONE;
		refittable_cargo_classes: bitmask(CC_PASSENGERS);
		default_cargo_type: PASS;
		cargo_capacity: 70;
		weight: DARTBOARD_DETERMINED_WEIGHT_PASSENGER ton;
		length: 8;
		badges: [
			"flag/US",
		];
	}
	graphics {
		default: spritegroup_wagon_passenger;
	}
}
