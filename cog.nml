item(FEAT_TRAINS, item_train_peppersass) {
	property {
		name: string(STR_PEPPERSASS_NAME);
		climates_available: bitmask(CLIMATE_TEMPERATE, CLIMATE_ARCTIC);
		introduction_date: date(1869,01,01);
		model_life: 12;
		vehicle_life: 12;
		reliability_decay: 20;
		refittable_cargo_classes: 0;
		loading_speed: 5;
		cost_factor: 20;
		running_cost_factor: 100;

		sprite_id: SPRITE_ID_NEW_TRAIN;
		// Real speed is 3mph, but other in-game trains can exceed that without difficulty even on slopes
		speed: 40mph;
		track_type: COG;
		power: 45 hp; // https://web.archive.org/web/20070814001057/http://www.cog-railway.com/lastrun.htm
		running_cost_base: RUNNING_COST_STEAM;
		cargo_capacity: 0;
		weight: 125 ton;
		engine_class: ENGINE_CLASS_STEAM;
		tractive_effort_coefficient: 1;
		length: 8;
		visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_STEAM, -1, DISABLE_WAGON_POWER);
		badges: [
			"flag/US",
			"power/steam",
		];
	}
	graphics {
		default: sprites_train_peppersass;
	}
}
item(FEAT_TRAINS, item_train_shingle) {
	property {
		name: string(STR_SHINGLE_NAME);
		climates_available: bitmask(CLIMATE_TEMPERATE, CLIMATE_ARCTIC);
		introduction_date: date(1869,01,01);
		model_life: 40;
		vehicle_life: 5;
		reliability_decay: 20;
		refittable_cargo_classes: bitmask(CC_PASSENGERS);
		loading_speed: 5;
		cost_factor: 1;
		running_cost_factor: 5;

		sprite_id: SPRITE_ID_NEW_TRAIN;
		speed: 60mph;
		misc_flags: bitmask(TRAIN_FLAG_NO_BREAKDOWN_SMOKE);
		extra_flags: bitmask(VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW);
		track_type: COG;
		ai_special_flag: AI_FLAG_PASSENGER;
		power: 1 hp;
		running_cost_base: RUNNING_COST_NONE;
		default_cargo_type: PASS;
		cargo_capacity: 4;
		weight: 1 ton;
		engine_class: ENGINE_CLASS_STEAM; // Really more gravity powered than anything else
		tractive_effort_coefficient: 0.1;
		air_drag_coefficient: 0.02;
		length: 3;
		visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
		badges: [
			"flag/US",
		];
	}
	graphics {
		default: spritegroup_train_shingle;
		can_attach_wagon: string(STR_ERROR_CANNOT_ATTACH_ANY);
	}
}
