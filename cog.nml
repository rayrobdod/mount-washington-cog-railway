item(FEAT_RAILTYPES, item_rail_cog) {
	property {
		label: "COG ";
		introduction_date: date(1869,01,01);
		name: string(STR_RAILTYPE_NAME);
		menu_text: string(STR_RAILTYPE_MENU);
		build_window_caption: string(STR_RAILTYPE_BUILD);
		autoreplace_text: string(STR_RAILTYPE_AUTOREPLACE);
		new_engine_text: string(STR_RAILTYPE_NEWENGINE);
		compatible_railtype_list: ["RAIL"];
		construction_cost: 16;
		maintenance_cost: 16;
		acceleration_model: ACC_MODEL_RAIL;
	}
	graphics {
		gui: sprites_rail_gui;
	}
}

