if (1 == vehicle_dates) {
	item(FEAT_TRAINS, item_train_peppersass) {
		property {
			introduction_date: date(1947,01,01);
			model_life: 20;
		}
	}
	item(FEAT_TRAINS, item_train_shingle) {
		property {
			introduction_date: date(1947,01,01);
			model_life: 35;
		}
	}
	item(FEAT_TRAINS, item_train_verticalboiler2) {
		property {
			introduction_date: date(1962,01,01);
			model_life: 20;
		}
	}
	item(FEAT_TRAINS, item_train_horizontalboiler) {
		property {
			introduction_date: date(1975,01,01);
		}
	}
	item(FEAT_TRAINS, item_train_spirit) {
		property {
			introduction_date: date(1990,01,01);
			model_life: 25;
		}
	}
	item(FEAT_TRAINS, item_train_speeder) {
		property {
			introduction_date: date(1990,01,01);
		}
	}
	item(FEAT_TRAINS, item_train_diesel) {
		property {
			introduction_date: date(2008,01,01);
		}
	}
}
if (disable_speeders) {
	item(FEAT_TRAINS, item_train_shingle) {
		property {
			climates_available: NO_CLIMATE;
		}
	}
	item(FEAT_TRAINS, item_train_speeder) {
		property {
			climates_available: NO_CLIMATE;
		}
	}
}
if (disable_prototypes) {
	item(FEAT_TRAINS, item_train_spirit) {
		property {
			climates_available: NO_CLIMATE;
		}
	}
}
