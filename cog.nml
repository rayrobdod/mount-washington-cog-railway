grf {
	grfid: "RRD\01";
	name: string(STR_GRF_NAME);
	desc: string(STR_GRF_DESCRIPTION);
	version: 0;
	min_compatible_version: 0;
	param {
		disable_speeders {
			type: bool;
			name: string(STR_PARAM_DISABLESPEEDER_NAME);
			desc: string(STR_PARAM_DISABLESPEEDER_DESC);
			def_value: 0;
		}
		disable_prototypes {
			type: bool;
			name: string(STR_PARAM_DISABLEPROTOTYPE_NAME);
			desc: string(STR_PARAM_DISABLEPROTOTYPE_DESC);
			def_value: 0;
		}
	}
	param {
		vehicle_dates {
			type: int;
			name: string(STR_PARAM_DATES_NAME);
			desc: string(STR_PARAM_DATES_DESC);
			min_value: 0;
			max_value: 1;
			def_value: 0;
			names: {
				0: string(STR_PARAM_DATES_VALUE_REAL);
				1: string(STR_PARAM_DATES_VALUE_TOY);
			};
		}
	}
}
railtypetable {
	COG: ["SrAN", "SRAN", "NrAN", "NRAN", "RAIL"],
}
cargotable {
	PASS,
	WOOD,
}
badgetable {
	"flag",
	"flag/US",
	"power",
	"power/steam",
	"power/diesel",
	"role/prototype",
}


