spritegroup spritegroup_train_shingle {
	loaded:	[sprites_train_shingle, sprites_train_shingle_pass];
	loading:	[sprites_train_shingle, sprites_train_shingle_pass];
}
spritegroup spritegroup_wagon_passenger {
	loaded:	[sprites_wagon_passenger, sprites_wagon_passenger];
	loading:	[sprites_wagon_passenger, sprites_wagon_passenger];
}
spritegroup spritegroup_wagon_flatcar {
	loaded:	[sprites_wagon_flatcar, sprites_wagon_flatcar_wood];
	loading:	[sprites_wagon_flatcar, sprites_wagon_flatcar_wood];
}

// The speed these vehicles ascend a 25% grade is very near OTTD's speed floor.
// Increase speed to make vehicles a little better to play with
const SPEED_MULTIPLIER = 5;

const DARTBOARD_DETERMINED_WEIGHT = 55;
const DARTBOARD_DETERMINED_WEIGHT_LIGHTER = 50;
const DARTBOARD_DETERMINED_WEIGHT_SPEEDER = 15;
const DARTBOARD_DETERMINED_WEIGHT_PASSENGER = 18;
const DARTBOARD_DETERMINED_WEIGHT_FLATCAR = 12;

const DARTBOARD_DETERMINED_POWER_VERTICALBOILER2 = 45;
const DARTBOARD_DETERMINED_POWER_HORIZONTALBOILER = 300;
const DARTBOARD_DETERMINED_POWER_SPIRIT = 400;
const DARTBOARD_DETERMINED_POWER_SPEEDER = 200;

item(FEAT_TRAINS, item_train_peppersass) {
	property {
		name: string(STR_PEPPERSASS_NAME);
		climates_available: ALL_CLIMATES;
		introduction_date: date(1866,08,01);
		model_life: 12;
		vehicle_life: 12;
		reliability_decay: 20;
		refittable_cargo_classes: 0;
		loading_speed: 5;
		cost_factor: 20;
		running_cost_factor: 100;

		sprite_id: SPRITE_ID_NEW_TRAIN;
		// Real speed is 3mph, but other in-game trains can exceed that without difficulty even on slopes
		speed: SPEED_MULTIPLIER * 3mph;
		track_type: COG;
		power: 45 hp; // https://web.archive.org/web/20070814001057/http://www.cog-railway.com/lastrun.htm
		running_cost_base: RUNNING_COST_STEAM;
		cargo_capacity: 0;
		weight: DARTBOARD_DETERMINED_WEIGHT_LIGHTER ton;
		engine_class: ENGINE_CLASS_STEAM;
		tractive_effort_coefficient: 1;
		length: 8;
		visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_STEAM, -1, DISABLE_WAGON_POWER);
		badges: [
			"flag/US",
			"power/steam",
		];
	}
	graphics {
		default: sprites_train_peppersass;
	}
}
item(FEAT_TRAINS, item_train_verticalboiler2) {
	property {
		name: string(STR_VERTICALBOILER2_NAME);
		climates_available: ALL_CLIMATES;
		introduction_date: date(1869,01,01);
		// Stephenson was scrapped in 1878.
		// The other members of this class were built later and scrapped or rebuilt earlier
		model_life: 10;
		vehicle_life: 10;
		reliability_decay: 20;
		refittable_cargo_classes: 0;
		loading_speed: 5;
		cost_factor: 20;
		running_cost_factor: 100;

		sprite_id: SPRITE_ID_NEW_TRAIN;
		speed: SPEED_MULTIPLIER * 3mph;
		track_type: COG;
		power: DARTBOARD_DETERMINED_POWER_VERTICALBOILER2 hp;
		running_cost_base: RUNNING_COST_STEAM;
		cargo_capacity: 0;
		weight: DARTBOARD_DETERMINED_WEIGHT_LIGHTER ton;
		engine_class: ENGINE_CLASS_STEAM;
		tractive_effort_coefficient: 1;
		length: 7;
		visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_STEAM, -3, DISABLE_WAGON_POWER);
		badges: [
			"flag/US",
			"power/steam",
		];
	}
	graphics {
		default: sprites_train_verticalboiler2;
	}
}
